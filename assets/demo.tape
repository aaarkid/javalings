Output assets/demo.gif
Set Shell bash
Set FontSize 20
Set Width 1000
Set Height 520
Set Padding 24
Set TypingSpeed 40ms
Set Theme { "background": "#0B0B0E", "foreground": "#ECEBF0", "black": "#2D2C36", "red": "#F04E6E", "green": "#5CE0A0", "yellow": "#F5C86B", "blue": "#6F58FF", "magenta": "#FF6FA8", "cyan": "#00A4FF", "white": "#BFBCC8", "brightBlack": "#4D4C57", "brightRed": "#FF577D", "brightGreen": "#5CE0A0", "brightYellow": "#E8FE96", "brightBlue": "#9D7CFF", "brightMagenta": "#FF84FF", "brightCyan": "#4FBEFE", "brightWhite": "#ECEBF0" }
Hide
Type "clear" Enter
Show
Type "java Javalings.java run variables4" Enter
Sleep 3s
Hide
Type "clear && sed -i '/start = current;/d' exercises/01_variables/Variables4.java" Enter
Show
Type "java Javalings.java run variables4" Enter
Sleep 4s
